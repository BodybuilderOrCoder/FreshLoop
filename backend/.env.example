# FreshLoop Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local/production environments.

# PostgreSQL Database Configuration
POSTGRES_USER=freshloop_user
POSTGRES_PASSWORD=freshloop_password123
POSTGRES_DB=freshloop_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Connection String
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Alembic Database Migration URL (defaults to DATABASE_URL if omitted)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Cache & Messaging
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Application Secrets & Security
JWT_SECRET=replace-with-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
