# Copy to .env.local and adjust. Never commit .env.local.

# FastAPI base URL, without a trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Seeded customer UUID used for the Quick Reorder demo until sign-in is wired
# into the storefront. Leave empty to show the signed-out Quick Reorder state.
NEXT_PUBLIC_DEMO_USER_ID=
